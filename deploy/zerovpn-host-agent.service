[Unit]
Description=CrimeTracker VPN host WireGuard agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=VPN_AGENT_SOCKET=/run/crimetracker-vpn/agent.sock
Environment=VPN_AGENT_STATE_DIR=/var/lib/crimetracker-vpn/agent
Environment=VPN_AGENT_TOKEN_FILE=/etc/crimetracker-vpn/agent.read.token
Environment=VPN_AGENT_APPLY_TOKEN_FILE=/etc/crimetracker-vpn/agent.apply.token
Environment=VPN_AGENT_SERVER_PRIVATE_KEY_FILE=/etc/crimetracker-vpn/server.private
ExecStart=/usr/local/sbin/zerovpn-host-agent
RuntimeDirectory=crimetracker-vpn
RuntimeDirectoryMode=0755
StateDirectory=crimetracker-vpn
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/crimetracker-vpn /var/lib/crimetracker-vpn

[Install]
WantedBy=multi-user.target
